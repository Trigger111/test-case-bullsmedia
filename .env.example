# Copy to .env and fill in real values. .env is git-ignored and must never
# be committed or shared - it carries the API token and the database password.

# APILayer exchangerates_data API
# Free token: https://apilayer.com/marketplace/exchangerates_data-api
API_KEY=your_apilayer_token_here

# MySQL
MYSQL_HOST=localhost
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=analyst_test
