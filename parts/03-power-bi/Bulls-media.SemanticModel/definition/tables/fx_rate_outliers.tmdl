	partition 'analyst_test fx_rate_outliers' = m
		mode: import
		source =
				let
				    Джерело = MySQL.Database("localhost", "analyst_test", [ReturnSingleDatabase=true]),
				    analyst_test_fx_rate_outliers = Джерело{[Schema="analyst_test",Item="fx_rate_outliers"]}[Data]
				in
				    analyst_test_fx_rate_outliers

