table fx_rate_outliers
	lineageTag: 4ab6fe46-7ffc-4343-901e-064453561d7f

	/// Count of rates flagged by the outlier test in SQL.
	measure 'Suspect FX Rates' =
			-- Daily rates that disagree with their own centred 31-day moving average
			-- by more than 2x or less than 0.5x. 194 rows out of 408,928 (0.047%).
			COUNTROWS ( fx_rate_outliers )
		formatString: #,##0
		displayFolder: 03 Data quality
		lineageTag: 83303b68-3ec8-4265-92ca-812b697ed27d

	column date
		dataType: dateTime
		formatString: Long Date
		lineageTag: 0d8ea819-fd45-4f2e-8852-e56822ba49a7
		summarizeBy: none
		sourceColumn: date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column year
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 0a29fea6-0eef-4d6d-b283-eeddb62cf996
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = Automatic

