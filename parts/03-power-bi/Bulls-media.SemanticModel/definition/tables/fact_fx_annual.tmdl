table fact_fx_annual
	lineageTag: 41dad777-f2c4-47ee-9686-2861e0f58a00

	/// The display currency driving every converted measure.
	measure 'Selected Currency' =
			-- Falls back to USD when no single currency is selected, so every
			-- converted measure has a defined base rather than going blank.
			SELECTEDVALUE ( dim_currency[currency_code], "USD" )
		displayFolder: 02 Currency conversion
		lineageTag: 420ef607-65ae-4bdf-864a-0276e7318aa8

	/// USD -> selected currency, annual average. Blank across multiple years by design.
	measure 'Conversion Rate' =
			-- Period-average rate: correct for FLOWS such as GDP.
			-- Use fact_fx_annual[eoy_rate] instead for STOCKS (debt, reserves).
			VAR Ccy = [Selected Currency]
			RETURN
			    CALCULATE (
			        SELECTEDVALUE ( fact_fx_annual[avg_rate] ),
			        REMOVEFILTERS ( dim_currency ),
			        dim_currency[currency_code] = Ccy
			    )
		formatString: #,##0.0000
		displayFolder: 02 Currency conversion
		lineageTag: 74856554-1e63-4526-86e3-962fc29ce48f

	/// Explicit 'no rate available' message rather than a silent blank.
	measure 'Currency Warning' =
			-- Says why a converted figure is missing or shaky, instead of leaving a blank.
			--
			-- Returns an empty string, never BLANK: a card bound to a blank measure
			-- prints the literal word (Blank) in the user's locale, which reads as a
			-- broken visual. An empty string renders as nothing at all.
			--
			-- Reads fact_fx_annual[is_partial_year], which trips when a currency-year has
			-- under 95% day coverage - either the year is still running, or the currency
			-- was not quoted for all of it (STN and XCG start 2025-07-18, MRU/SLE/VES
			-- start late 2022).
			--
			-- Only years that actually put a number on the page are judged. Two things
			-- used to trigger it with no risk behind them, and a warning that is always
			-- lit is a warning nobody reads:
			--
			--   * USD is the base of the whole series, so the rate is identically 1.
			--     A partial year of 1.0 averages to 1.0 - there is nothing to distort.
			--   * 2026 has FX for 235 of 365 days and is flagged partial for all 172
			--     currencies, but GDP stops at 2025. An incomplete 2026 rate cannot
			--     reach any figure shown, because no 2026 figure exists.
			--
			-- YearsShown therefore filters dim_year down to the years carrying GDP in the
			-- CURRENT context - so on Country Detail it narrows again to the years that
			-- one country actually reports.
			VAR Ccy = [Selected Currency]
			VAR BaseCcy =
			    -- Read the base from the data rather than hard-coding "USD": if the series
			    -- is ever rebased, this follows. Blank if the base is not unique, which
			    -- simply restores the old behaviour instead of hiding a real warning.
			    CALCULATE ( SELECTEDVALUE ( fact_fx_annual[base_currency] ), REMOVEFILTERS ( ) )
			VAR YearsShown =
			    FILTER ( VALUES ( dim_year[year] ), NOT ISBLANK ( [GDP (USD)] ) )
			VAR YearsInScope = COUNTROWS ( YearsShown )
			VAR YearsWithRate =
			    CALCULATE (
			        COUNTROWS ( fact_fx_annual ),
			        REMOVEFILTERS ( dim_currency ),
			        dim_currency[currency_code] = Ccy,
			        YearsShown
			    )
			VAR YearsPartial =
			    CALCULATE (
			        COUNTROWS ( fact_fx_annual ),
			        REMOVEFILTERS ( dim_currency ),
			        dim_currency[currency_code] = Ccy,
			        fact_fx_annual[is_partial_year] = 1,
			        YearsShown
			    )
			VAR Missing = YearsInScope - COALESCE ( YearsWithRate, 0 )
			RETURN
			    SWITCH (
			        TRUE (),
			        Ccy = BaseCcy, "",
			        ISBLANK ( YearsInScope ), "",
			        Missing > 0,
			            Ccy & ": no rate available for " & Missing & " of " & YearsInScope & " year(s) with GDP",
			        YearsPartial > 0,
			            Ccy & ": " & YearsPartial & " year(s) priced on a partial year of rates",
			        ""
			    )
		displayFolder: 03 Data quality
		lineageTag: 4d67b48a-64bb-49f5-846f-1bd07c984e8d

