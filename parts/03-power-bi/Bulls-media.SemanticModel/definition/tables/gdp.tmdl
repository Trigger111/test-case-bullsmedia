	/// Row-level GDP per capita in USD, for validation at country-year grain.
	column 'GDP per Capita Row (USD)' =
			VAR PopulationForRow =
			    LOOKUPVALUE (
			        population[population],
			        population[country_iso3], gdp[country_iso3],
			        population[year], gdp[year]
			    )
			RETURN
			    DIVIDE ( gdp[gdp_in_usd], PopulationForRow )
		dataType: double
		formatString: #,##0.00
		lineageTag: c176ccfe-969f-46cf-b754-651b38a2e17b
		summarizeBy: none

	partition 'analyst_test gdp' = m
