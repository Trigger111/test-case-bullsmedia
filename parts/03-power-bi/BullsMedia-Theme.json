{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.153.json",
  "name": "Bulls Media",
  "dataColors": [
    "#EEC106",
    "#3D4B7B",
    "#2E8B84",
    "#B5651D",
    "#8FA5C4",
    "#6B3F5E",
    "#C9A227",
    "#2B3134"
  ],
  "good": "#2E8B57",
  "neutral": "#C9A227",
  "bad": "#B23A48",
  "minimum": "#FDF6DD",
  "center": "#EFCB5C",
  "maximum": "#9C7C04",
  "null": "#F2F2F0",
  "firstLevelElements": "#383F42",
  "secondLevelElements": "#6B7280",
  "thirdLevelElements": "#F7F7F5",
  "fourthLevelElements": "#9AA3AE",
  "background": "#FFFFFF",
  "secondaryBackground": "#E8E6E1",
  "tableAccent": "#EEC106",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 26,
      "color": "#383F42"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#383F42"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#383F42"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#353535"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E8E6E1"
              }
            },
            "radius": 6
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 8,
            "right": 8
          }
        ],
        "categoryAxis": [
          {
            "gridlineStyle": "dotted",
            "gridlineColor": {
              "solid": {
                "color": "#EFEFEC"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "gridlineStyle": "dotted",
            "gridlineColor": {
              "solid": {
                "color": "#EFEFEC"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "autoSizeColumnWidth": true,
            "columnAdjustment": "growToFit",
            "backColor": {
              "solid": {
                "color": "#F7F7F5"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#383F42"
              }
            },
            "bold": true
          }
        ],
        "values": [
          {
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FBFBFA"
              }
            },
            "fontColorPrimary": {
              "solid": {
                "color": "#353535"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#353535"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "autoSizeColumnWidth": true,
            "columnAdjustment": "growToFit",
            "backColor": {
              "solid": {
                "color": "#F7F7F5"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#383F42"
              }
            },
            "bold": true
          }
        ],
        "values": [
          {
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FBFBFA"
              }
            },
            "fontColorPrimary": {
              "solid": {
                "color": "#353535"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#353535"
              }
            }
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "bold": true,
            "$id": "default"
          }
        ],
        "label": [
          {
            "$id": "default",
            "show": false
          }
        ],
        "cardCalloutArea": [
          {
            "paddingUniform": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E8E6E1"
              }
            },
            "radius": 6
          }
        ],
        "title": [
          {
            "show": true
          }
        ],
        "spacing": [
          {
            "customizeSpacing": true,
            "verticalSpacing": -6
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "labels": [
          {
            "show": false,
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "gridlineShow": true,
            "showAxisTitle": false
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "showAxisTitle": false,
            "innerPadding": 20,
            "gridlineShow": false
          }
        ],
        "dataPoint": [
          {
            "borderShow": false
          }
        ],
        "legend": [
          {
            "show": true,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            }
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "labels": [
          {
            "show": false,
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "gridlineShow": true,
            "showAxisTitle": false
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "showAxisTitle": false,
            "innerPadding": 20,
            "gridlineShow": false
          }
        ],
        "dataPoint": [
          {
            "borderShow": false
          }
        ],
        "legend": [
          {
            "show": true,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            }
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "labels": [
          {
            "show": false,
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "gridlineShow": true,
            "showAxisTitle": false
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "showAxisTitle": false,
            "innerPadding": 20,
            "gridlineShow": false
          }
        ],
        "dataPoint": [
          {
            "borderShow": false
          }
        ],
        "legend": [
          {
            "show": true,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            }
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "labels": [
          {
            "show": false,
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "gridlineShow": true,
            "showAxisTitle": false
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "showAxisTitle": false,
            "innerPadding": 20,
            "gridlineShow": false
          }
        ],
        "dataPoint": [
          {
            "borderShow": false
          }
        ],
        "legend": [
          {
            "show": true,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2.5,
            "lineChartType": "smooth",
            "interpolationSmooth": "monotoneX",
            "areaShow": false,
            "areaMatchStrokeColor": true
          }
        ],
        "labels": [
          {
            "show": false,
            "fontSize": 9
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "showAxisTitle": false,
            "gridlineStyle": "dotted",
            "gridlineColor": {
              "solid": {
                "color": "#EFEFEC"
              }
            }
          }
        ],
        "legend": [
          {
            "show": true,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontFamily": "Segoe UI Semibold",
            "textSize": 10,
            "fontColor": {
              "solid": {
                "color": "#383F42"
              }
            },
            "outlineStyle": 0
          }
        ],
        "items": [
          {
            "fontFamily": "Segoe UI",
            "textSize": 9,
            "fontColor": {
              "solid": {
                "color": "#353535"
              }
            },
            "outlineStyle": 0,
            "padding": 2
          }
        ],
        "date": [
          {
            "fontFamily": "Segoe UI",
            "textSize": 9,
            "fontColor": {
              "solid": {
                "color": "#353535"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#383F42"
              }
            },
            "fontSize": 28,
            "bold": true,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E8E6E1"
              }
            },
            "radius": 6
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 12,
            "right": 12
          }
        ]
      }
    }
  }
}
